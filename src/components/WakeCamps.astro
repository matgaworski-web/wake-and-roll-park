---
import { siteConfig } from '../content/site';
---

<section class="camps-section" id="polkolonie">
  <div class="container">
    <div class="camps-banner">
      <div class="camps-content">
        <span class="badge badge-sunset">Dla Dzieci i Młodzieży 7–16 Lat</span>
        <h2 class="camps-title">Półkolonie Wakeboardowe <span class="text-gradient">WakeWakacje</span></h2>
        
        <p class="camps-desc">
          Oficjalne letnie obozy i półkolonie sportów wodnych nad Stawami Stefańskiego.
          Codzienna nauka pływania na wyciągu 2.0 pod okiem wielokrotnego Mistrza Polski Mateusza Gaworskiego, 
          kompletny sprzęt, opieka wykwalifikowanych wychowawców, obiad i ubezpieczenie NNW.
        </p>

        <div class="camps-highlights">
          <div class="highlight-item">
            <i class="fa-solid fa-person-swimming" aria-hidden="true"></i>
            <div>
              <strong>2 bloki na wodzie dziennie</strong>
              <small>Ok. 6 godzin pływania w tygodniu</small>
            </div>
          </div>
          <div class="highlight-item">
            <i class="fa-solid fa-utensils" aria-hidden="true"></i>
            <div>
              <strong>Pełne wyżywienie</strong>
              <small>Ciepły obiad, owoce i napoje</small>
            </div>
          </div>
          <div class="highlight-item">
            <i class="fa-solid fa-shield-virus" aria-hidden="true"></i>
            <div>
              <strong>100% Bezpieczeństwa</strong>
              <small>Ratownik, kamizelki i kaski</small>
            </div>
          </div>
          <div class="highlight-item">
            <i class="fa-solid fa-clock" aria-hidden="true"></i>
            <div>
              <strong>Opieka 7:00 – 16:00</strong>
              <small>Turnusy od poniedziałku do piątku</small>
            </div>
          </div>
        </div>

        <div class="camps-actions">
          <a href={siteConfig.socials.wakeCampsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg">
            <span>Zapisz Dziecko na WakeWakacje.pl</span>
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
          </a>
          <a href="tel:+48667102828" class="camps-phone-link">
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            <span>Infolinia półkolonii: <strong>+48 667 102 828</strong></span>
          </a>
        </div>
      </div>

      <div class="camps-visual">
        <img 
          src="/images/park/2P0A5175.jpg" 
          alt="Dzieci i instruktorzy na półkoloniach wakeboardowych w Wake & Roll Park" 
          loading="lazy"
          class="camps-img"
          width="600"
          height="450"
        />
        <div class="camps-coach-card">
          <i class="fa-solid fa-medal coach-badge" aria-hidden="true"></i>
          <div>
            <strong>Mateusz Gaworski</strong>
            <small>Główny Trener • Mistrz Polski</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .camps-section {
    padding: 80px 0;
    background: #060a12;
  }

  .camps-banner {
    background: linear-gradient(135deg, rgba(16, 28, 52, 0.9) 0%, rgba(10, 16, 30, 0.95) 100%);
    border: 1px solid rgba(255, 126, 95, 0.3);
    border-radius: var(--radius-lg);
    padding: 48px 40px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .camps-banner {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }
  }

  .camps-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: #fff;
    margin: 12px 0 16px 0;
    line-height: 1.2;
  }

  .camps-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .camps-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (max-width: 480px) {
    .camps-highlights {
      grid-template-columns: 1fr;
    }
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    padding: 12px 14px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .highlight-item i {
    font-size: 1.3rem;
    color: var(--color-accent-sunset);
  }

  .highlight-item strong {
    display: block;
    font-size: 0.875rem;
    color: #fff;
  }

  .highlight-item small {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .camps-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .camps-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #cbd5e1;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .camps-phone-link strong {
    color: #fff;
  }

  .camps-phone-link:hover {
    color: var(--color-primary);
  }

  /* Wizualia */
  .camps-visual {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .camps-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .camps-coach-card {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background: rgba(10, 18, 34, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 12px 16px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .coach-badge {
    color: #fbbf24;
    font-size: 1.4rem;
  }

  .camps-coach-card strong {
    display: block;
    color: #fff;
    font-size: 0.9rem;
  }

  .camps-coach-card small {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
