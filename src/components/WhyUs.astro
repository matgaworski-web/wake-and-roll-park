---
const features = [
  {
    icon: "fa-solid fa-water-ladder",
    title: "Starty z Pomoście w 15 Minut",
    desc: "Dzięki wyciągowi dwusłupowemu ze zmienną prędkością aż 95% początkujących wstaje na deskę już podczas pierwszej sesji. Zero czekania w wodzie."
  },
  {
    icon: "fa-solid fa-users-viewfinder",
    title: "Kameralnie: Max 4 Osoby na Torze",
    desc: "Podczas gdy na dużych 5-słupowych wyciągach w Polsce tłoczy się po 10-12 osób naraz, u nas masz gwarancję 4 osób na 1h i maksymalną uwagę instruktora."
  },
  {
    icon: "fa-solid fa-medal",
    title: "Szkoła Mistrza Polski",
    desc: "Zajęcia i półkolonie WakeWakacje prowadzi Mateusz Gaworski – wielokrotny Mistrz Polski w Wakeboardzie. Prawdziwa wiedza bez domysłów."
  },
  {
    icon: "fa-solid fa-martini-glass-citrus",
    title: "Kompletny Chillout & Beach Bar",
    desc: "Nie tylko woda: leżaki, zimne napoje, deski SUP na spokojny akwen Stawów Stefańskiego i bezpłatny duży parking tuż przy plaży."
  }
];

const comparisonRows = [
  {
    param: "Liczba osób na torze jednocześnie",
    us: "Maksymalnie 4 osoby (komfort i pływanie)",
    them: "Często 8–12 osób na dużym wyciągu (kolejki i upadki)"
  },
  {
    param: "Czas i uwaga operatora/trenera",
    us: "100% czasu operator skupiony na Tobie",
    them: "Brak indywidualnej regulacji prędkości pod Ciebie"
  },
  {
    param: "Bezpieczeństwo początkujących",
    us: "Brak konieczności płynięcia wpław do brzegu",
    them: "Po upadku długie dopływanie z deską do pomostu"
  },
  {
    param: "Rezerwacja online w czasie rzeczywistym",
    us: "Jasny kalendarz slotów 10:00–19:00",
    them: "Często rezerwacje tylko telefoniczne lub niejasne sloty"
  },
  {
    param: "Sprzęt i atesty",
    us: "Atestowane kaski z ochroną uszu + kamizelki w cenie",
    them: "Dopłaty do kasków lub zużyty sprzęt"
  }
];
---

<section class="why-us-section" id="dlaczego-my">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Jakość Bez Kompromisów</span>
      <h2 class="section-title">Dlaczego Wake & Roll Park w Łodzi?</h2>
      <p class="section-desc">
        Porównaj standardy i zobacz, dlaczego Stawy Stefańskiego to ulubiona miejscówka wakeboardowa w centralnej Polsce.
      </p>
    </div>

    <!-- 4 filary -->
    <div class="features-grid">
      {features.map(f => (
        <div class="feature-box">
          <div class="feature-icon-wrap">
            <i class={f.icon} aria-hidden="true"></i>
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>

    <!-- Tabela porównawcza -->
    <div class="comparison-card">
      <div class="card-headline">
        <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
        <h3>Jak Wypadamy na Tle Konkurencji?</h3>
      </div>
      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Standard / Cecha</th>
              <th class="col-highlight">Wake & Roll Park Łódź</th>
              <th class="col-muted">Inne Wakeparki</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map(row => (
              <tr>
                <td class="param-name">{row.param}</td>
                <td class="col-highlight">
                  <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                  <span>{row.us}</span>
                </td>
                <td class="col-muted">
                  <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
                  <span>{row.them}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .why-us-section {
    padding: 80px 0;
    background: #060a12;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-box {
    background: rgba(16, 26, 46, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 24px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .feature-box:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 229, 255, 0.35);
  }

  .feature-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(0, 229, 255, 0.1);
    color: var(--color-accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 16px;
  }

  .feature-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
  }

  .feature-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .comparison-card {
    background: rgba(13, 20, 36, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 32px;
    overflow: hidden;
  }

  .card-headline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .card-headline i {
    color: var(--color-accent-orange);
    font-size: 1.4rem;
  }

  .card-headline h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  .comparison-table th {
    padding: 14px 16px;
    text-align: left;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .comparison-table th.col-highlight {
    color: var(--color-accent-blue);
    background: rgba(0, 229, 255, 0.05);
    border-radius: 6px 6px 0 0;
  }

  .comparison-table td {
    padding: 14px 16px;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .param-name {
    color: #e2e8f0;
    font-weight: 600;
  }

  .comparison-table td.col-highlight {
    background: rgba(0, 229, 255, 0.03);
    color: #fff;
    font-weight: 600;
  }

  .comparison-table td.col-highlight i {
    color: #10b981;
    margin-right: 8px;
  }

  .comparison-table td.col-muted {
    color: var(--color-text-muted);
  }

  .comparison-table td.col-muted i {
    color: #ef4444;
    margin-right: 8px;
  }
</style>
